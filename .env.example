PORT=5100
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lunchboxai

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
# Optional extra secret for password-reset OTP hashing (defaults to JWT_SECRET)
# PASSWORD_RESET_OTP_PEPPER=

OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Comma-separated OAuth client IDs for POST /api/auth/google/mobile (ID token `aud`). Defaults to GOOGLE_CLIENT_ID if unset.
# GOOGLE_ALLOWED_AUDIENCES=web_client_id.apps.googleusercontent.com,android_client_id,ios_client_id
# Optional; default is APP_BASE_URL + /api/auth/google/callback (must match Google Console redirect URIs)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

APP_BASE_URL=http://localhost:5100
FRONTEND_URL=http://localhost:5173

# S3: AI-generated lunchbox PNGs (optional — if unset, saves under uploads/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=lunchboxai
# Optional CloudFront / custom origin for generated image URLs (no trailing slash)
# AWS_S3_PUBLIC_URL=https://d111111abcdef8.cloudfront.net

# Gmail: use an App Password (not your login password). https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=LunchboxAI <your_email@gmail.com>

# Firebase Admin (FCM) — use ONE of:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # minified one line
# FIREBASE_SERVICE_ACCOUNT_JSON_B64=...   # base64 of the JSON file (good for CI/hosting)
# FIREBASE_SERVICE_ACCOUNT_PATH=/var/app/firebase.json   # absolute path on server
# GOOGLE_APPLICATION_CREDENTIALS=./lunchboxai-....json
# Production (PM2): use absolute path, e.g. /var/www/lunchboxai/lunchboxai-....json

# Secret for POST /api/notifications/broadcast (header X-Broadcast-Secret)
BROADCAST_SECRET=change_me_to_a_long_random_string
